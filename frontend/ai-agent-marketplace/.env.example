# AI Agent Marketplace Frontend - Environment Variables
# Copy this file to .env.local and fill in your values

# ========== REQUIRED ==========
# Select network: testnet | mainnet (derives RPC, passphrase, USDC id unless overridden)
VITE_STELLAR_NETWORK=testnet

# Deployed Soroban contract ID
VITE_CONTRACT_ID=CDXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional overrides — must match VITE_STELLAR_NETWORK or the build fails
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
VITE_USDC_CONTRACT_ID=CBIELSO6KZLFBUSGZ47QRYCYMHK4D2H5IMKBORJGUJVAVKZOQK4D7IAJ

# ========== IPFS (for metadata & deliverable uploads) ==========
# IPFS pinning service API key.
#   Pinata (default):   create a JWT at https://app.pinata.cloud/developers/api-keys
#   web3.storage:       create a token at https://web3.storage (set VITE_IPFS_PROVIDER=web3storage)
VITE_IPFS_API_KEY=your_pinata_jwt_or_web3storage_token_here

# Pinning backend: "pinata" (default) or "web3storage"
VITE_IPFS_PROVIDER=pinata

# Optional custom pinning-service endpoint for uploading agent metadata JSON.
# When set, the frontend POSTs the metadata JSON to this URL and expects a
# response containing an ipfs:// URI (e.g. { "uri": "ipfs://<cid>" } or
# { "IpfsHash": "<cid>" }), which is stored on-chain as the agent's metadata_uri.
# Leave empty to fall back to the configured VITE_IPFS_PROVIDER.
VITE_PINNING_ENDPOINT=

# Public IPFS gateway used to build read-URLs from CIDs.
# Options:
#   https://ipfs.io/ipfs/          (public, rate-limited)
#   https://nftstorage.link/ipfs/  (fast, backed by NFT.Storage CDN)
#   https://cloudflare-ipfs.com/ipfs/
#   https://gateway.pinata.cloud/ipfs/
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# ========== FEE SPONSORSHIP (testnet prototype, see docs/ops/fee-sponsorship.md) ==========
# When set, signed transactions are sent to this endpoint, which wraps them in
# a fee-bump paid by the platform so users don't need XLM for fees. Leave empty
# to have users pay their own fees.
VITE_FEE_SPONSOR_URL=
# Server-side only (Vercel project env, never prefixed with VITE_):
#   FEE_SPONSOR_ENABLED=true
#   FEE_SPONSOR_SECRET=S...
#   FEE_SPONSOR_MAX_FEE_STROOPS=1000000
#   FEE_SPONSOR_MAX_TX_PER_HOUR=20
#   FEE_SPONSOR_DAILY_BUDGET_STROOPS=500000000

# ========== OPTIONAL ==========
# Analytics
VITE_GA_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
VITE_SENTRY_DSN=https://xxxx@sentry.io/xxxx

# Feature flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_TESTNET_BANNER=true

# ========== COMPLIANCE (sanctions screening & region restrictions) ==========
# Comma-separated list of Stellar addresses (G...) that are blocked from
# posting listings or placing bids. Checked in the frontend before any
# post/bid transaction is submitted. Leave empty to disable.
# Example: VITE_BLOCKED_ADDRESSES=GAAA...,GBBB...
VITE_BLOCKED_ADDRESSES=

# Comma-separated list of blocked region codes (ISO 3166-1 alpha-2, e.g. "KP,IR,SY").
# Users whose region is blocked cannot post or bid. Leave empty to disable.
# Example: VITE_BLOCKED_REGIONS=KP,IR,SY
VITE_BLOCKED_REGIONS=

# NOTE: The frontend blocklist above is a UX convenience only. The authoritative
# denylist is enforced on-chain and is managed by the admin multisig without
# requiring a contract redeploy. Legal sign-off for the blocklist and region
# restrictions must be documented before enabling on mainnet.
# ========== FIAT ON/OFF-RAMP (SEP-24) ==========
# Show "Deposit USDC" / "Withdraw USDC" in the wallet menu, powered by a
# SEP-24 anchor's interactive flow. Disabled unless set to "true".
VITE_ENABLE_FIAT_RAMP=false

# Home domain of the SEP-24 anchor (its stellar.toml must publish
# TRANSFER_SERVER_SEP0024, WEB_AUTH_ENDPOINT and SIGNING_KEY).
#   Testnet: testanchor.stellar.org (SDF test anchor)
#   Mainnet: the domain of a licensed USDC anchor you have an agreement with
VITE_SEP24_ANCHOR_DOMAIN=testanchor.stellar.org
